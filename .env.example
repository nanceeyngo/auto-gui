# ==============================================================================
# auto-gui - sample environment configuration
#
# Copy this file to `.env` and fill in real values as needed:
#
#   cp .env.example .env
#
# All settings are optional and fall back to sensible defaults (see
# src/agent/config.py and src/grounding/config.py) if left unset.
# ==============================================================================


# ------------------------------------------------------------------------------
# Agent (src/agent/config.py, AGENT_ prefix)
# ------------------------------------------------------------------------------

# Model identifier passed to the language model backend.
AGENT_MODEL=qwen/qwen3.6-27b

# API key for the language model backend, if required.
AGENT_API_KEY=

# Override the model backend's base URL (e.g. for a self-hosted or
# OpenAI-compatible gateway).
AGENT_BASE_URL=

# Sampling temperature (0.0-2.0). Lower is more deterministic, which is
# generally preferable for GUI automation.
AGENT_TEMPERATURE=0.0

# Maximum number of reasoning/tool-use iterations before the agent
# gives up on a task.
AGENT_MAX_ITERATIONS=30

# Delay (seconds) after each GUI action before the next screenshot is
# taken, to let the UI settle.
AGENT_POST_ACTION_DELAY=0.5

# Directory used to store temporary screenshots during a run.
AGENT_SCREENSHOT_DIRECTORY=.screenshots

# Whether to keep screenshots on disk after a run completes (useful
# for debugging; disabled by default to avoid disk bloat).
AGENT_KEEP_SCREENSHOTS=false

# Timeout (seconds) for language model requests.
AGENT_REQUEST_TIMEOUT=120.0

# Hard cap on the number of tool calls per run, independent of
# max_iterations, as a defense-in-depth safeguard.
AGENT_MAX_TOOL_CALLS=100

# Optional random seed for deterministic sampling, if the backend
# supports it.
AGENT_SEED=

# Enable verbose agent-level logging (distinct from GUI_AGENT_LOG_LEVEL
# below, which controls the structured logging subsystem).
AGENT_VERBOSE=false


# ------------------------------------------------------------------------------
# Grounding framework (src/grounding/config.py, GROUNDING_ prefix)
# ------------------------------------------------------------------------------


GROUNDING_PROVIDER=vlmrun

# Default request timeout (seconds) for grounding provider calls.
GROUNDING_REQUEST_TIMEOUT=30.0

# Connection timeout (seconds).
GROUNDING_CONNECT_TIMEOUT=10.0

# Retry attempts for framework-level failures (provider unavailable,
# parsing failures, rate limits). Distinct from
# GROUNDING_TRANSPORT_MAX_RETRIES below.
GROUNDING_PROVIDER_MAX_RETRIES=2

# HTTP User-Agent sent with grounding provider requests.
GROUNDING_USER_AGENT=grounding-framework/1.0


# ------------------------------------------------------------------------------
# VLM Run grounding provider (src/grounding/providers/vlmrun.py, VLMRUN_ prefix)
# ------------------------------------------------------------------------------

# API key for the VLM Run grounding backend. Required to use the
# "vlmrun" provider; without it, provider initialization fails.
VLMRUN_API_KEY=

# Base URL for the VLM Run API. Leave unset to use the SDK default.
VLMRUN_BASE_URL=

# Model identifier used for grounding requests.
VLMRUN_MODEL=

# Retry attempts for transport-level failures (connection reset,
# transient network errors, HTTP 502/503/504).
VLMRUN_TRANSPORT_MAX_RETRIES=2

# Whether to verify TLS certificates. Only disable for local/self-signed
# testing setups; never disable in production.
VLMRUN_VERIFY_SSL=true


# ------------------------------------------------------------------------------
# Structured logging (src/grounding/logging_utils.py)
#
# Shared by both the `agent` and `grounding` packages -- both log
# through the same "auto_gui" logger hierarchy.
# ------------------------------------------------------------------------------

# Log level for the shared "auto_gui" logger hierarchy.
# One of: DEBUG, INFO, WARNING, ERROR.
GUI_AGENT_LOG_LEVEL=INFO

# Optional path to a file that log records should also be written to,
# in addition to stdout. Leave unset to log to stdout only.
GUI_AGENT_LOG_FILE=

# Optional override for the log line format (stdlib `logging` %-style
# format string).
GUI_AGENT_LOG_FORMAT=

# Optional override for agent max tokens. If unset, the default is 1052. Set to 0 to disable max tokens.
AGENT_MAX_TOKENS=1052
