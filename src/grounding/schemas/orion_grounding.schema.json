{
  "type": "object",
  "required": ["detections"],
  "properties": {
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["bbox", "confidence", "label"],
        "properties": {
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1, "description": "Normalized x-coordinate of the top-left corner" },
              { "type": "number", "minimum": 0, "maximum": 1, "description": "Normalized y-coordinate of the top-left corner" },
              { "type": "number", "minimum": 0, "maximum": 1, "description": "Normalized width of the bounding box" },
              { "type": "number", "minimum": 0, "maximum": 1, "description": "Normalized height of the bounding box" }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
